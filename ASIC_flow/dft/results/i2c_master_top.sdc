set_input_delay -clock wb_clk_i  -max 1.6  [get_ports wb_we_i]
set_input_delay -clock wb_clk_i  -max 1.6  [get_ports wb_stb_i]
set_input_delay -clock wb_clk_i  -max 1.6  [get_ports wb_cyc_i]
set_input_delay -clock wb_clk_i  -max 1.6  [get_ports scl_pad_i]
