###################################################################
set sdc_version 2.1

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current uA
set_driving_cell -lib_cell IBUFFX2 [get_ports wb_clk_i]
set_driving_cell -lib_cell IBUFFX2 [get_ports wb_rst_i]
set_driving_cell -lib_cell IBUFFX2 [get_ports test_mode]
set_driving_cell -lib_cell IBUFFX2 [get_ports dft_clk_i]
set_driving_cell -lib_cell IBUFFX2 [get_ports dft_rst_i]
set_driving_cell -lib_cell IBUFFX2 [get_ports arst_i]
