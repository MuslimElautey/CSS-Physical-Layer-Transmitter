set_driving_cell -lib_cell IBUFFX2 [get_ports {wb_adr_i[1]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {wb_adr_i[0]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {wb_dat_i[7]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {wb_dat_i[6]}]
