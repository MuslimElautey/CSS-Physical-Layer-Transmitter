create_pg_mesh_pattern straps_vddvss  -layers {                {{horizontal_layer: M9}{width: 2}                    {spacing: interleaving} {pitch: 20} {offset:0.856} {trim:true}}                {{vertical_layer: M8}{width: 2}                    {spacing: interleaving}{pitch: 20} {offset: 0.856} {trim:true}}             }
